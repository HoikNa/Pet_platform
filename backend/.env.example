# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/petid_db

# ── JWT ───────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── AWS ───────────────────────────────────────────
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=pet-id-uploads
SQS_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/123456789/pet-scan-queue

# ── App ───────────────────────────────────────────
STAGE=dev
PRESIGNED_URL_EXPIRES=3600
